# ── Groq (gratuit) ──
# Crée un compte sur https://console.groq.com
# API Keys → Create API Key
GROQ_API_KEY=gsk_...

# ── Database (Supabase) ──
# Projet Supabase → Settings → Database → Connection string → URI
DATABASE_URL="postgresql://user:password@host:6543/postgres"

# ── NextAuth ──
# Génère un secret avec : openssl rand -base64 32
NEXTAUTH_SECRET="ton-secret-ici"
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth ──
# console.cloud.google.com → Credentials → OAuth 2.0 Client ID
# Redirect URI : http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Stripe (pour plus tard) ──
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRO_PRICE_ID=price_...
